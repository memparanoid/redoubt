impl redoubt_codec_core::Decode for Choice {
    fn decode_from(
        &mut self,
        buf: &mut &mut [u8],
    ) -> Result<(), redoubt_codec_core::DecodeError> {
        let mut tag: u8 = 0;
        let tag_field: [&mut dyn redoubt_codec_core::DecodeZeroize; 1] = [
            redoubt_codec_core::collections::helpers::to_decode_zeroize_dyn_mut(&mut tag),
        ];
        redoubt_codec_core::collections::helpers::decode_fields(
            tag_field.into_iter(),
