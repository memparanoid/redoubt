                if left - 1 == 0 {
                    return Err(
                        redoubt_vault_core::CipherBoxError::IntentionalCipherBoxError
                            .into(),
                    );
                }
            }
        }
        self.inner.open_mut(f)
    }
    #[cfg(any(test, feature = "test-utils"))]
    pub fn set_failure_mode(&self, mode: TestableSecretsBoxFailureMode) {
        use core::sync::atomic::Ordering;
        match mode {
            TestableSecretsBoxFailureMode::None => {
                self.failure_counter.store(0, Ordering::Relaxed);
            }
            TestableSecretsBoxFailureMode::FailOnNthOperation(n) => {
                self.failure_counter.store(n, Ordering::Relaxed);
            }
        }
    }
