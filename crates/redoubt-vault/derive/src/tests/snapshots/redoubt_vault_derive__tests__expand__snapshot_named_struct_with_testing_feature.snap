impl redoubt_vault_core::CipherBoxDyns<1> for TestableSecrets {
    fn to_encryptable_dyn_fields(
        &mut self,
    ) -> [&mut dyn redoubt_vault_core::Encryptable; 1] {
        [&mut self.secret_key]
    }
    fn to_decryptable_dyn_fields(
        &mut self,
    ) -> [&mut dyn redoubt_vault_core::Decryptable; 1] {
        [&mut self.secret_key]
    }
}
impl redoubt_vault_core::EncryptStruct<1> for TestableSecrets {
    fn encrypt_into(
        &mut self,
        aead: &mut redoubt_aead::Aead,
        aead_key: &[u8],
        nonces: &mut redoubt_vault_core::Nonces<1>,
        tags: &mut redoubt_vault_core::Tags<1>,
